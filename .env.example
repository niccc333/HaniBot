# Bot token from https://discord.com/developers/applications > Bot > Reset Token
DISCORD_TOKEN=

# Channel where Hani posts welcome messages (right-click channel > Copy Channel ID).
# Leave blank to fall back to the server's system channel.
WELCOME_CHANNEL_ID=

# The link Hani replies with when someone runs /hanilink
HANI_LINK_URL=https://example.com

# Optional: guild ID for instant slash-command sync (right-click server > Copy Server ID).
# Leave blank to sync globally (can take up to 1 hour to appear).
GUILD_ID=

# Optional: sticker ID used for welcome waves.
WELCOME_STICKER_ID=749054660769218631

# --- Birthdays ---
# WHERE TO PUT THE BIRTHDAY CHANNEL ID:
# 1. In Discord, enable Settings > Advanced > Developer Mode.
# 2. Right-click the channel you want birthday wishes in (e.g. #birthdays) > Copy Channel ID.
# 3. Paste it below after BIRTHDAY_CHANNEL_ID=  (and do the same in your real .env file).
# Birthdays post ONLY to this channel — there is no fallback.
BIRTHDAY_CHANNEL_ID=

# Optional: path to the birthday CSV (default: birthdays.csv).
# CSV format (header required): name,birthday,user_id
# Example: Hani,04-23,123456789012345678   (birthday is MM-DD, user_id via right-click user > Copy User ID)
BIRTHDAY_CSV_PATH=birthdays.csv

# Optional: hour of day (0-23, local server time unless BIRTHDAY_TIMEZONE is set) to post wishes. Default: 9
BIRTHDAY_CHECK_HOUR=9

# Optional: IANA timezone for the daily check, e.g. Europe/Berlin, America/New_York, UTC.
# Leave blank to use the machine's local time.
BIRTHDAY_TIMEZONE=
