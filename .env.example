# Copy this file to .env and fill in your values.

# Bot token from https://discord.com/developers/applications > Bot > Reset Token
DISCORD_TOKEN=

# Channel where Hani posts welcome messages (right-click channel > Copy Channel ID).
# Leave blank to fall back to the server's system channel.
WELCOME_CHANNEL_ID=

# The link Hani replies with when someone runs /hanilink
HANI_LINK_URL=https://example.com
